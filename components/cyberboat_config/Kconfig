config CYBERBOAT_RECEIVER_CONSOLE_LOG
    bool "Log receiver channel and mapped command data to console"
    default n
    help
        Prints raw channel pulse widths/ages and the mapped throttle, steering,
        auxiliary servo, and arm request to the serial console at a configurable
        interval. Useful for bring-up with FlySky FS-R6B and similar generic
        individual-channel PWM receivers. Disable for normal operation to reduce
        log noise.

config CYBERBOAT_RECEIVER_CONSOLE_LOG_INTERVAL_MS
    int "Receiver console log interval (ms)"
    range 50 5000
    default 500
    depends on CYBERBOAT_RECEIVER_CONSOLE_LOG
    help
        Minimum time between receiver console log lines when logging is enabled.

