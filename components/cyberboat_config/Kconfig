menu "Four-channel differential drive mapping"

config CYBERBOAT_RC_DRIVE_SERVO_CHANNEL
    int "Auxiliary servo channel (zero based)"
    range 0 7
    default 0

config CYBERBOAT_RC_DRIVE_THROTTLE_CHANNEL
    int "Motor power channel (zero based)"
    range 0 7
    default 1

config CYBERBOAT_RC_DRIVE_DIRECTION_CHANNEL
    int "Forward/reverse speed channel (zero based)"
    range 0 7
    default 2

config CYBERBOAT_RC_DRIVE_STEERING_CHANNEL
    int "Differential steering channel (zero based)"
    range 0 7
    default 3

config CYBERBOAT_RC_DRIVE_LEFT_MOTOR_INDEX
    int "H-bridge motor index installed on the left (0=motor 1, 1=motor 2)"
    range 0 1
    default 0
    help
        Select which H-bridge motor output is physically on the left. Index 0
        is motor 1 on IN1/IN2 (D0/D1); index 1 is motor 2 on IN3/IN4 (D2/D3).
        The other output is treated as the right motor.

config CYBERBOAT_RC_DRIVE_DEADBAND_US
    int "Drive channel deadband (us)"
    range 0 200
    default 30

config CYBERBOAT_RC_DRIVE_SERVO_TRAVEL_PERCENT
    int "Auxiliary servo travel (% of calibrated range)"
    range 1 100
    default 50
    help
        50 percent uses half of the configured servo calibration span. With a
        500-2500 us calibration representing 180 degrees, this produces a
        nominal 90-degree end-to-end sweep. Verify the servo datasheet and
        calibrate its pulse limits before connecting the linkage.

config CYBERBOAT_RC_DRIVE_SERVO_REVERSED
    bool "Reverse auxiliary servo sweep"
    default n

config CYBERBOAT_RC_DRIVE_DIRECTION_REVERSED
    bool "Reverse forward and reverse positions"
    default n

config CYBERBOAT_RC_DRIVE_STEERING_REVERSED
    bool "Reverse differential steering"
    default n

