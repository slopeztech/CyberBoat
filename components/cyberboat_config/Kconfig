menu "CyberBoat configuration"

choice CYBERBOAT_VESSEL_MODE
    prompt "Vessel behavior mode"
    default CYBERBOAT_MODE_SINGLE_MOTOR_ONLY

config CYBERBOAT_MODE_SINGLE_MOTOR_ONLY
    bool "1 motor, no servos"

config CYBERBOAT_MODE_SINGLE_MOTOR_RUDDER
    bool "1 motor + rudder servo"

config CYBERBOAT_MODE_SINGLE_MOTOR_AUX_SERVO
    bool "1 motor + auxiliary servo actuator"

config CYBERBOAT_MODE_SINGLE_MOTOR_RUDDER_AUX
    bool "1 motor + rudder servo + auxiliary servo actuator"

config CYBERBOAT_MODE_TWIN_MOTOR_ONLY
    bool "2 differential motors, no servos"

config CYBERBOAT_MODE_TWIN_MOTOR_RUDDER
    bool "2 differential motors + rudder servo"

config CYBERBOAT_MODE_TWIN_MOTOR_AUX_SERVO
    bool "2 differential motors + auxiliary servo actuator"

config CYBERBOAT_MODE_TWIN_MOTOR_RUDDER_AUX
    bool "2 differential motors + rudder servo + auxiliary servo actuator"

endchoice

config CYBERBOAT_MOTOR_COUNT
    int
    range 1 2
    default 2 if CYBERBOAT_MODE_TWIN_MOTOR_ONLY
    default 2 if CYBERBOAT_MODE_TWIN_MOTOR_RUDDER
    default 2 if CYBERBOAT_MODE_TWIN_MOTOR_AUX_SERVO
    default 2 if CYBERBOAT_MODE_TWIN_MOTOR_RUDDER_AUX
    default 1

config CYBERBOAT_RUDDER_SERVO_ENABLED
    bool
    default y if CYBERBOAT_MODE_SINGLE_MOTOR_RUDDER
    default y if CYBERBOAT_MODE_SINGLE_MOTOR_RUDDER_AUX
    default y if CYBERBOAT_MODE_TWIN_MOTOR_RUDDER
    default y if CYBERBOAT_MODE_TWIN_MOTOR_RUDDER_AUX
    default n

config CYBERBOAT_AUX_SERVO_ENABLED
    bool
    default y if CYBERBOAT_MODE_SINGLE_MOTOR_AUX_SERVO
    default y if CYBERBOAT_MODE_SINGLE_MOTOR_RUDDER_AUX
    default y if CYBERBOAT_MODE_TWIN_MOTOR_AUX_SERVO
    default y if CYBERBOAT_MODE_TWIN_MOTOR_RUDDER_AUX
    default n

config CYBERBOAT_SERVO_ENABLED
    bool
    default y if CYBERBOAT_RUDDER_SERVO_ENABLED
    default y if CYBERBOAT_AUX_SERVO_ENABLED
    default n

config CYBERBOAT_ACTUATORS_ENABLED
    bool "Enable actuator outputs (motors and servos)"
    depends on !CYBERBOAT_RUN_UNIT_TESTS
    default n
    help
        Keep disabled until actuator wiring, power, and safe-stop behavior are validated.

config CYBERBOAT_RUN_UNIT_TESTS
    bool "Repeat pure component unit tests in the test profile"
    default n
    help
        Use the dedicated unit-test PlatformIO environment. Tests must not initialize actuator hardware.

config CYBERBOAT_RUN_HARDWARE_TESTS
    bool "Run an interactive hardware diagnostic instead of the boat application"
    depends on !CYBERBOAT_RUN_UNIT_TESTS
    default n
    help
        Select a dedicated receiver or servo diagnostic. The servo diagnostic requires
        CYBERBOAT_ACTUATORS_ENABLED and never initializes the motor driver.

choice CYBERBOAT_HARDWARE_TEST_COMPONENT
    prompt "Hardware diagnostic component"
    depends on CYBERBOAT_RUN_HARDWARE_TESTS
    default CYBERBOAT_HARDWARE_TEST_SERVO

config CYBERBOAT_HARDWARE_TEST_SERVO
    bool "Servo output"

config CYBERBOAT_HARDWARE_TEST_PWM_RECEIVER
    bool "PWM receiver input monitor"

config CYBERBOAT_HARDWARE_TEST_HBRIDGE
    bool "Two-motor H-bridge inputs D0-D3"
    depends on CYBERBOAT_MOTOR_COUNT = 2

endchoice

choice CYBERBOAT_HARDWARE_TEST_SERVO_ROLE
    prompt "Servo role to test"
    depends on CYBERBOAT_RUN_HARDWARE_TESTS && CYBERBOAT_HARDWARE_TEST_SERVO
    default CYBERBOAT_HARDWARE_TEST_SERVO_AUXILIARY

config CYBERBOAT_HARDWARE_TEST_SERVO_RUDDER
    bool "Rudder"

config CYBERBOAT_HARDWARE_TEST_SERVO_AUXILIARY
    bool "Auxiliary"

endchoice

choice CYBERBOAT_HARDWARE_TEST_SERVO_MODE
    prompt "Servo output test mode"
    depends on CYBERBOAT_RUN_HARDWARE_TESTS && CYBERBOAT_HARDWARE_TEST_SERVO
    default CYBERBOAT_HARDWARE_TEST_SERVO_CENTER

config CYBERBOAT_HARDWARE_TEST_SERVO_CENTER
    bool "Hold center pulse for oscilloscope"

config CYBERBOAT_HARDWARE_TEST_SERVO_SMALL_STEPS
    bool "Small +/-5% position steps"

endchoice

config CYBERBOAT_MOTOR_1_IN1_GPIO
    int "Motor 1 bridge input 1 GPIO"
    range 0 48
    default 3
    help
        Connect to the bridge IN1/logic input, not the motor output terminal.
        GPIO3 is an ESP32-S3 strapping pin. Ensure the bridge input does not bias it
        to an incompatible level during reset; use another GPIO if uncertain.

config CYBERBOAT_MOTOR_1_IN2_GPIO
    int "Motor 1 bridge input 2 GPIO"
    range 0 48
    default 4
    help
        Connect to the bridge IN2/logic input, not the motor output terminal.

config CYBERBOAT_MOTOR_1_REVERSED
    bool "Reverse motor 1 direction"
    default n

if CYBERBOAT_MOTOR_COUNT = 2

config CYBERBOAT_MOTOR_2_IN1_GPIO
    int "Motor 2 bridge input 1 GPIO"
    range 0 48
    default 5
    help
        Connect to the bridge IN3/logic input for motor 2.

config CYBERBOAT_MOTOR_2_IN2_GPIO
    int "Motor 2 bridge input 2 GPIO"
    range 0 48
    default 6
    help
        Connect to the bridge IN4/logic input for motor 2.

config CYBERBOAT_MOTOR_2_REVERSED
    bool "Reverse motor 2 direction"
    default n

endif

